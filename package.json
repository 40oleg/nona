{
  "name": "nona",
  "version": "0.8.0",
  "description": "Experimental JavaScript subset AOT compiler for native Windows, Linux, macOS and BSD executables",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/40oleg/nona.git"
  },
  "bugs": {
    "url": "https://github.com/40oleg/nona/issues"
  },
  "homepage": "https://github.com/40oleg/nona#readme",
  "engines": {
    "node": ">=26"
  },
  "type": "module",
  "bin": {
    "nona": "dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test dist/tests/*.test.js",
    "check": "npm run build && npm test",
    "compare": "npm run build && node scripts/compare-examples.mjs",
    "compare:linux": "npm run build && node scripts/compare-linux.mjs",
    "test262:smoke": "npm run build && node scripts/test262-smoke.mjs",
    "check:weak-memory": "npm run build && node scripts/check-weak-memory.mjs",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
